# Shared zsh config. Machine-specific stuff (personal aliases, project
# shortcuts, SSH hosts, secrets) goes in ~/.zshrc.local, which isn't tracked.

# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

command -v brew >/dev/null && [[ -s "$(brew --prefix)/etc/autojump.sh" ]] && . "$(brew --prefix)/etc/autojump.sh"
# fzf key bindings (Ctrl-R history, Ctrl-T files, Alt-C cd) + completion.
# ~/.fzf.zsh exists for a git install of fzf; Homebrew's fzf ships them via --zsh.
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
elif command -v fzf >/dev/null; then
  source <(fzf --zsh 2>/dev/null)
fi

alias v=nvim
alias python=python3
alias clr=clear
alias showdesktop="defaults write com.apple.finder CreateDesktop true && killall Finder"
alias hidedesktop="defaults write com.apple.finder CreateDesktop false && killall Finder"
# Hide TMUX/TERM_PROGRAM so Claude's logo renders in truecolor inside tmux
# (its splash renderer downgrades to 256 colors when it detects a multiplexer).
# These vars are unset outside tmux anyway, so this is a no-op there.
alias cld="env -u TMUX -u TERM_PROGRAM claude --dangerously-skip-permissions"

# Attach to the persistent 'main' session, or create it if it doesn't exist.
alias tm="tmux new-session -A -s main"

# Clean clipboard: strip leading/trailing whitespace per line + squeeze blank lines.
# Use after copying text from the terminal that picked up stray indentation.
pbclean() { pbpaste | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | cat -s | pbcopy; }

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# bun
export BUN_INSTALL="$HOME/.bun"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

export PATH="$HOME/.local/bin:$PATH"
export COLORTERM=truecolor

[ -f ~/.zshrc.local ] && source ~/.zshrc.local
